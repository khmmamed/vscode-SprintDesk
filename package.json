{
  "name": "vscode-sprintdesk",
  "publisher": "khmamed",
  "displayName": "vscode-SprintDesk",
  "description": "Plan-native autonomous workforce orchestration for Visual Studio Code",
  "version": "1.1.0",
  "repository": {
    "url": "https://github.com/khmmamed/vscode-SprintDesk.git",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development --config ./webpack/extension.config.js",
    "watch": "npm-run-all --parallel watch:*",
    "watch:ext": "webpack --mode development --watch --config ./webpack/extension.config.js",
    "watch:wv": "webpack serve --mode development --config ./webpack/webview.config.js",
    "package": "npm run clean && npm-run-all --parallel package:*",
    "package:ext": "webpack --mode production --config ./webpack/extension.config.js",
    "package:wv": "webpack --mode production --config ./webpack/webview.config.js",
    "compile-tests": "rimraf out && tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p . -w --outDir out --noEmit false",
    "pretest": "npm run lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext ts",
    "clean": "rimraf dist",
    "test": "npm run compile-tests && mocha",
    "test:headless": "npm run test",
    "mcp": "rimraf out && tsc -p . --outDir out --noEmit false && node out/mcp/stdioServer.js",
    "standup": "rimraf out && tsc -p . --outDir out --noEmit false && node out/cli/standup.js",
    "worker": "rimraf out && tsc -p . --outDir out --noEmit false && node out/cli/worker.js",
    "scheduler": "rimraf out && tsc -p . --outDir out --noEmit false && node out/cli/scheduler.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "sprintdesk.refresh",
        "title": "SprintDesk: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sprintdesk.executeDevPipeline",
        "title": "SprintDesk: Execute Dev Pipeline"
      },
      {
        "command": "sprintdesk.executeCancellationPipeline",
        "title": "SprintDesk: Execute Cancellation Pipeline"
      },
      {
        "command": "sprintdesk.cancelActiveRun",
        "title": "SprintDesk: Cancel Active Run"
      },
      {
        "command": "sprintdesk.openPipelineEditor",
        "title": "SprintDesk: Open Pipeline Editor"
      },
      {
        "command": "sprintdesk.refreshDevInspection",
        "title": "SprintDesk: Refresh"
      },
      {
        "command": "sprintdesk.scheduleDevPipeline",
        "title": "SprintDesk: Schedule Dev Pipeline"
      },
      {
        "command": "sprintdesk.triggerDevSchedule",
        "title": "SprintDesk: Trigger Dev Schedule"
      },
      {
        "command": "sprintdesk.listDevSchedules",
        "title": "SprintDesk: List Dev Schedules"
      },
      {
        "command": "sprintdesk.startScheduler",
        "title": "SprintDesk: Start Scheduler"
      },
      {
        "command": "sprintdesk.stopScheduler",
        "title": "SprintDesk: Stop Scheduler"
      },
      {
        "command": "sprintdesk.scheduleEventDevPipeline",
        "title": "SprintDesk: Schedule Event Dev Pipeline"
      },
      {
        "command": "sprintdesk.emitDevEvent",
        "title": "SprintDesk: Emit Dev Event"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sprintdesk",
          "title": "SprintDesk",
          "icon": "./assets/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "sprintdesk": [
        {
          "id": "sprintdesk-main",
          "name": "SprintDesk"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sprintdesk.refresh",
          "when": "view == sprintdesk-main",
          "group": "navigation@9"
        }
      ]
    }
  },
  "devDependencies": {
    "@estruyf/vscode": "^1.1.0",
    "@types/chai": "^5.2.3",
    "@types/d3-dispatch": "^2.0.0",
    "@types/glob": "^7.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/mocha": "^9.1.1",
    "@types/node": "16.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^8.3.4",
    "@types/vscode": "^1.99.0",
    "@types/webpack": "^5.28.1",
    "@types/webpack-dev-server": "^4.7.2",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "@vscode/test-electron": "^2.1.5",
    "chai": "^4.3.7",
    "css-loader": "^6.7.1",
    "eslint": "^8.20.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^7.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^3.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.1",
    "typescript": "^4.7.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0",
    "webpack-manifest-plugin": "^5.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react-flow-renderer": "^10.3.17"
  }
}
