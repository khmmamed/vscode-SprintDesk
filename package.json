{
  "name": "vscode-sprintdesk",
  "publisher": "khmamed",
  "displayName": "vscode-SprintDesk",
  "description": "A Visual Studio Code extension for managing sprints and tasks in an agile development workflow",
"version": "0.11.0",
  "repository": {
    "url": "https://github.com/khmmamed/vscode-SprintDesk.git",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack --mode development --config ./webpack/extension.config.js",
    "watch": "npm-run-all --parallel watch:*",
    "watch:ext": "webpack --mode development --watch --config ./webpack/extension.config.js",
    "watch:wv": "webpack serve --mode development --config ./webpack/webview.config.js",
    "package": "npm run clean && npm-run-all --parallel package:*",
    "package:ext": "webpack --mode production --config ./webpack/extension.config.js",
    "package:wv": "webpack --mode production --config ./webpack/webview.config.js",
    "compile-tests": "rimraf out && tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p . -w --outDir out --noEmit false",
    "pretest": "npm run lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext ts",
    "clean": "rimraf dist",
    "test": "npm run compile-tests && mocha",
    "test:headless": "npm run test",
    "mcp": "rimraf out && tsc -p . --outDir out --noEmit false && node out/mcp/stdioServer.js",
    "standup": "rimraf out && tsc -p . --outDir out --noEmit false && node out/cli/standup.js",
    "worker": "rimraf out && tsc -p . --outDir out --noEmit false && node out/cli/worker.js",
    "scheduler": "rimraf out && tsc -p . --outDir out --noEmit false && node out/cli/scheduler.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "sprintdesk.refresh",
        "title": "SprintDesk: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sprintdesk.startMcp",
        "title": "SprintDesk: Start MCP Server",
        "icon": "$(server)"
      },
      {
        "command": "sprintdesk.viewWorkforce",
        "title": "SprintDesk: View Workforce",
        "icon": "$(organization)"
      },
      {
        "command": "sprintdesk.addEmployee",
        "title": "SprintDesk: Add Person",
        "icon": "$(person-add)"
      },
      {
        "command": "sprintdesk.createTeam",
        "title": "SprintDesk: Create Team",
        "icon": "$(new-folder)"
      },
      {
        "command": "sprintdesk.assignToTeam",
        "title": "SprintDesk: Assign to Team",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.setTeamLead",
        "title": "SprintDesk: Set Team Lead",
        "icon": "$(star)"
      },
      {
        "command": "sprintdesk.setEmployeeStatus",
        "title": "SprintDesk: Set Availability",
        "icon": "$(circle-filled)"
      },
      {
        "command": "sprintdesk.removeEmployee",
        "title": "SprintDesk: Remove Employee",
        "icon": "$(trash)"
      },
      {
        "command": "sprintdesk.syncPeopleFromGit",
        "title": "SprintDesk: Sync People from Git",
        "icon": "$(sync)"
      },
      {
        "command": "sprintdesk.processQueue",
        "title": "SprintDesk: Process Queue",
        "icon": "$(play)"
      },
      {
        "command": "sprintdesk.openWorkforce",
        "title": "SprintDesk: Open Workforce Control Center",
        "icon": "$(window)"
      },
      {
        "command": "sprintdesk.createTaskForEmployee",
        "title": "SprintDesk: Create Task & Run",
        "icon": "$(add)"
      },
      {
        "command": "sprintdesk.cancelRun",
        "title": "SprintDesk: Cancel Run",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sprintdesk",
          "title": "SprintDesk",
          "icon": "./assets/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "sprintdesk": [
        {
          "id": "sprintdesk-main",
          "name": "SprintDesk"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sprintdesk.refresh",
          "when": "view == sprintdesk-main",
          "group": "navigation@9"
        },
        {
          "command": "sprintdesk.addEmployee",
          "when": "view == sprintdesk-main",
          "group": "navigation@1"
        },
        {
          "command": "sprintdesk.createTeam",
          "when": "view == sprintdesk-main",
          "group": "navigation@2"
        },
        {
          "command": "sprintdesk.syncPeopleFromGit",
          "when": "view == sprintdesk-main",
          "group": "navigation@3"
        },
        {
          "command": "sprintdesk.processQueue",
          "when": "view == sprintdesk-main",
          "group": "navigation@4"
        },
        {
          "command": "sprintdesk.openWorkforce",
          "when": "view == sprintdesk-main",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "sprintdesk.assignToTeam",
          "when": "view == sprintdesk-main && viewItem =~ /^employee/",
          "group": "inline@1"
        },
        {
          "command": "sprintdesk.createTaskForEmployee",
          "when": "view == sprintdesk-main && viewItem == employeeAgent",
          "group": "inline@0"
        },
        {
          "command": "sprintdesk.setEmployeeStatus",
          "when": "view == sprintdesk-main && viewItem =~ /^employee/",
          "group": "inline@2"
        },
        {
          "command": "sprintdesk.removeEmployee",
          "when": "view == sprintdesk-main && viewItem =~ /^employee/",
          "group": "inline@3"
        },
        {
          "command": "sprintdesk.setTeamLead",
          "when": "view == sprintdesk-main && viewItem == workforceTeam",
          "group": "inline@4"
        },
        {
          "command": "sprintdesk.cancelRun",
          "when": "view == sprintdesk-main && viewItem == runItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SprintDesk",
      "properties": {
        "sprintdesk.projectPrefix": {
          "type": "string",
          "default": "SPD",
          "description": "Project prefix used for code display (e.g., SPD-101)",
          "scope": "resource"
        },
        "sprintdesk.epicPrefix": {
          "type": "string",
          "default": "epic_",
          "description": "Epic ID prefix (for internal use)",
          "scope": "resource"
        },
        "sprintdesk.epicStartNumber": {
          "type": "number",
          "default": 1,
          "description": "Starting number for epic IDs",
          "scope": "resource"
        },
        "sprintdesk.epicPadding": {
          "type": "number",
          "default": 2,
          "description": "Number of digits for epic ID padding",
          "scope": "resource"
        },
        "sprintdesk.epicMdFilenamePattern": {
          "type": "string",
          "default": "[Epic]_${title}.md",
          "description": "Template for epic .md filename",
          "scope": "resource",
          "markdownDescription": "Template for epic .md filename. Use ${title} for epic title."
        },
        "sprintdesk.taskPrefix": {
          "type": "string",
          "default": "task_",
          "description": "Task ID prefix (e.g., task_ → task_100)",
          "scope": "resource",
          "markdownDescription": "Prefix used when generating new task IDs. Include trailing underscore if desired."
        },
        "sprintdesk.taskStartNumber": {
          "type": "number",
          "default": 100,
          "description": "Starting number for task IDs",
          "scope": "resource"
        },
        "sprintdesk.taskPadding": {
          "type": "number",
          "default": 3,
          "description": "Number of digits for task ID padding",
          "scope": "resource"
        },
        "sprintdesk.taskMdFilenamePattern": {
          "type": "string",
          "default": "[task-${taskNumber}]_${tasktitle}.md",
          "description": "Template for task .md filename",
          "scope": "resource",
          "markdownDescription": "Template for task .md filename. Use ${taskNumber} for task code and ${tasktitle} for title."
        },
        "sprintdesk.backlogMdFilenamePattern": {
          "type": "string",
          "default": "[Backlog]_${name}.md",
          "description": "Template for backlog .md filename",
          "scope": "resource",
          "markdownDescription": "Template for backlog .md filename. Use ${name} for backlog name."
        },
        "sprintdesk.sprintPrefix": {
          "type": "string",
          "default": "sprint_",
          "description": "Sprint ID prefix",
          "scope": "resource"
        },
        "sprintdesk.sprintStartNumber": {
          "type": "number",
          "default": 1,
          "description": "Starting number for sprint IDs",
          "scope": "resource"
        },
        "sprintdesk.sprintPadding": {
          "type": "number",
          "default": 1,
          "description": "Number of digits for sprint ID padding",
          "scope": "resource"
        },
        "sprintdesk.sprintMdFilenamePattern": {
          "type": "string",
          "default": "[Sprint]_${id}.md",
          "description": "Template for sprint .md filename",
          "scope": "resource",
          "markdownDescription": "Template for sprint .md filename. Use ${id} for sprint id."
        },
        "sprintdesk.defaultBacklog": {
          "type": "string",
          "default": "features",
          "description": "Default backlog for new tasks",
          "scope": "resource",
          "markdownDescription": "Name of the backlog where new tasks are created by default."
        },
        "sprintdesk.defaultStatus": {
          "type": "string",
          "default": "waiting",
          "description": "Default status for new tasks",
          "enum": [
            "waiting",
            "in-progress",
            "done",
            "blocked",
            "cancelled"
          ],
          "enumDescriptions": [
            "Not started yet",
            "Work in progress",
            "Completed",
            "Blocked — requires attention",
            "Cancelled / won't do"
          ],
          "scope": "resource"
        },
        "sprintdesk.defaultPriority": {
          "type": "string",
          "default": "medium",
          "description": "Default priority for new tasks",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Low priority",
            "Normal priority",
            "High priority"
          ],
          "scope": "resource"
        },
        "sprintdesk.showIds": {
          "type": "boolean",
          "default": true,
          "description": "Show IDs in task labels",
          "scope": "resource"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "sprintdesk-mcp",
        "label": "SprintDesk MCP Server"
      }
    ]
  },
  "devDependencies": {
    "@estruyf/vscode": "^1.1.0",
    "@types/d3-dispatch": "^2.0.0",
    "@types/glob": "^7.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/mocha": "^9.1.1",
    "@types/node": "16.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^8.3.4",
    "@types/vscode": "^1.99.0",
    "@types/webpack": "^5.28.1",
    "@types/webpack-dev-server": "^4.7.2",
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "@vscode/test-electron": "^2.1.5",
    "css-loader": "^6.7.1",
    "eslint": "^8.20.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "postcss-loader": "^7.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^3.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.4.1",
    "typescript": "^4.7.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0",
    "webpack-manifest-plugin": "^5.0.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react-flow-renderer": "^10.3.17"
  }
}
