{
  "name": "sprintdesk-mcp",
  "version": "1.1.0",
  "description": "MCP server for SprintDesk controlled autonomous workforce - exposes plan, run, queue, event, checkpoint, input, cycle, organizer, agent, approval and workforce operations for AI agents",
  "author": "SprintDesk",
  "repository": "https://github.com/khmmamed/vscode-SprintDesk",
  "homepage": "https://github.com/khmmamed/vscode-SprintDesk",
  "capabilities": {
    "tools": true,
    "resources": false
  },
  "connection": {
    "http": {
      "url": "http://localhost:3847/mcp",
      "methods": [
        "POST"
      ]
    },
    "stdio": {
      "command": "npm run mcp",
      "cwd": "<workspace-root>"
    }
  },
  "toolCount": 43,
  "tools": {
    "agent": [
      "sprintdesk_agentsList",
      "sprintdesk_agentsGet"
    ],
    "run": [
      "sprintdesk_runsCreate",
      "sprintdesk_runsList",
      "sprintdesk_runsGet",
      "sprintdesk_runsCancel",
      "sprintdesk_runsUpdate"
    ],
    "queue": [
      "sprintdesk_queueGet",
      "sprintdesk_queueProcess"
    ],
    "event": [
      "sprintdesk_eventsPublish",
      "sprintdesk_eventsList"
    ],
    "audit": [
      "sprintdesk_auditList"
    ],
    "context": [
      "sprintdesk_projectContext"
    ],
    "workforce": [
      "sprintdesk_skillsList",
      "sprintdesk_skillsUpsert",
      "sprintdesk_policyGet",
      "sprintdesk_recommendEmployees",
      "sprintdesk_activitySummary"
    ],
    "history": [
      "sprintdesk_getHistory",
      "sprintdesk_trackChange"
    ],
    "mcp": [
      "sprintdesk_mcpServersList",
      "sprintdesk_mcpServersAdd",
      "sprintdesk_mcpServersUpdate",
      "sprintdesk_mcpServersRemove",
      "sprintdesk_mcpToolsList",
      "sprintdesk_mcpCheck",
      "sprintdesk_mcpCall"
    ],
    "approvals": [
      "sprintdesk_gatesGet",
      "sprintdesk_gatesSet",
      "sprintdesk_approvalsList",
      "sprintdesk_approvalsApprove",
      "sprintdesk_approvalsReject",
      "sprintdesk_employeeConfigure"
    ],
    "input": [
      "sprintdesk_inputsList",
      "sprintdesk_inputsIngest"
    ],
    "plan": [
      "sprintdesk_plansList",
      "sprintdesk_plansGet",
      "sprintdesk_plansReplan"
    ],
    "checkpoint": [
      "sprintdesk_checkpointsList",
      "sprintdesk_checkpointsApproveDeploy",
      "sprintdesk_checkpointsRejectDeploy"
    ],
    "cycle": [
      "sprintdesk_cyclesList"
    ],
    "organizer": [
      "sprintdesk_organizerRun"
    ]
  },
  "usage": {
    "http_curl": "curl -X POST http://localhost:3847/mcp -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}'",
    "http_call": "curl -X POST http://localhost:3847/mcp -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"sprintdesk_plansList\",\"arguments\":{}}}'",
    "stdio": "cd <workspace> && npm run mcp"
  }
}
